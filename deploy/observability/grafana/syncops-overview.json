{
  "id": null,
  "uid": "syncops-overview",
  "title": "SyncOps Delivery Overview",
  "description": "Operational metrics collected directly from the SyncOps API.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "tags": [
    "syncops"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API scrape",
      "description": "The most recent Prometheus scrape status.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "syncops-prometheus"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "up{job=\"syncops-api\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "Waiting for first scrape",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "syncops-prometheus"
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Queued or waiting",
      "description": "Events in the queued and retry-scheduled states.",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "syncops-prometheus"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(syncops_events{job=\"syncops-api\",status=~\"queued|retry_scheduled\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "syncops-prometheus"
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Dead letters",
      "description": "Current events that exhausted automatic recovery or met a permanent error.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "syncops-prometheus"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "syncops_events{job=\"syncops-api\",status=\"dead_letter\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "syncops-prometheus"
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Worker heartbeat age",
      "description": "Seconds since the latest worker heartbeat. No value appears before the first heartbeat.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "syncops-prometheus"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "clamp_min(time() - (syncops_worker_heartbeat_timestamp_seconds{job=\"syncops-api\"} > 0), 0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "No heartbeat",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 45
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "syncops-prometheus"
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Persisted events by status",
      "description": "Historical snapshots of current state counts. An event moves between status series during recovery.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 15,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "syncops-prometheus"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "syncops_events{job=\"syncops-api\"}",
          "legendFormat": "{{status}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "syncops-prometheus"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 6,
      "title": "Processing attempts",
      "description": "Average recorded attempts per second over five minutes, including initial attempts and retries.",
      "type": "timeseries",
      "gridPos": {
        "x": 15,
        "y": 5,
        "w": 9,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "syncops-prometheus"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "rate(syncops_attempts_total{job=\"syncops-api\"}[5m])",
          "legendFormat": "Attempts/s",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "syncops-prometheus"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    }
  ]
}
