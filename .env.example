# Generate a local .env using: pwsh -File scripts/Initialize-Compose.ps1
# Keep these secrets unique to this isolated local installation.
SYNCOPS_DB_ADMIN_PASSWORD=
SYNCOPS_DB_PASSWORD=
SYNCOPS_ADMIN_PASSWORD=
SYNCOPS_OPERATOR_PASSWORD=
SYNCOPS_VIEWER_PASSWORD=
SYNCOPS_MOCK_TOKEN=
# Optional deployment-level webhook token. Empty disables webhooks.
SYNCOPS_WEBHOOK_SECRET=
# Published only on IPv4 loopback.
SYNCOPS_WEB_PORT=8080
